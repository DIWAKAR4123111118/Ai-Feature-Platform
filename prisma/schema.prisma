generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model features {
  id           Int           @id @default(autoincrement())
  repo_id      Int?
  name         String        @db.VarChar(255)
  version      String?       @db.VarChar(50)
  description  String?
  status       String?       @default("discovered") @db.VarChar(50)
  approved     Boolean?      @default(false)
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  updated_at   DateTime?     @default(now()) @db.Timestamp(6)
  repositories repositories? @relation(fields: [repo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([approved], map: "idx_features_approved")
}

model repositories {
  id                  Int              @id @default(autoincrement())
  github_url          String           @unique @db.VarChar(500)
  name                String           @db.VarChar(255)
  description         String?
  stars               Int?             @default(0)
  language            String?          @db.VarChar(100)
  license_spdx        String?          @db.VarChar(100)
  license_text        String?          @db.Text
  license_risk_tier   String?          @default("unknown") @db.VarChar(50)
  license_accepted    Boolean?         @default(false)
  license_accepted_by String?          @db.VarChar(255)
  license_accepted_at DateTime?        @db.Timestamp(6)
  security_score      Int?
  quality_score       Int?
  status              String?          @default("pending") @db.VarChar(50)
  created_at          DateTime?        @default(now()) @db.Timestamp(6)
  updated_at          DateTime?        @default(now()) @db.Timestamp(6)
  features            features[]
  security_scans      security_scans[]

  @@index([status], map: "idx_repos_status")
}

model security_scans {
  id                    Int           @id @default(autoincrement())
  repo_id               Int?
  scan_type             String        @db.VarChar(100)
  result                Json?
  vulnerabilities_count Int?          @default(0)
  passed                Boolean?      @default(false)
  scanned_at            DateTime?     @default(now()) @db.Timestamp(6)
  repositories          repositories? @relation(fields: [repo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  password_hash   String    @db.VarChar(255)
  github_username String?   @db.VarChar(255)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([email], map: "idx_users_email")
}